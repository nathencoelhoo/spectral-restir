#version 460
// Spectral unidirectional path tracer with next-event estimation (NEE) and MIS.
// Milestone 2: NEE on the area light, power-heuristic MIS against BSDF sampling.
// Glass blocks shadow rays (caustics come only from BSDF-sampled paths, MIS weight 1).
// The MIS/pdf math is mirrored and tested on CPU in tests/nee_test.cpp.
// Modes: 0 = furnace (glass in white environment), 1 = prism scene with NEE+MIS,
//        2 = same scene as 1 but brute-force (no NEE): an unbiased reference to test mode 1,
//        3 = mode 1 with the caustic channel split out and estimated by RIS candidates (ReSTIR part 1).
//
// Caustic channel (mode 3). For a pixel whose primary hit x is the diffuse floor, the light is split exactly:
//   base estimate  = everything except paths  x -> 1..CAUSTIC_MAX_GLASS glass vertices -> light
//   caustic channel = those excluded paths, estimated from random-replay seeds (evalCaustic) via RIS.
// The base tracer drops precisely the events evalCaustic counts, so base + caustic is unbiased.
// Pass 0 (candidates) writes one reservoir per pixel; pass 1 shades. Part 2 adds reuse between them.
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : enable
#include "spectral.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, std430) buffer Accum { vec4 accum[]; };
layout(set = 0, binding = 2, std430) readonly buffer Verts { vec4 verts[]; };
layout(set = 0, binding = 3, std430) readonly buffer Idx { uint indices[]; };
layout(set = 0, binding = 4, std430) readonly buffer Mats { uint primMat[]; };
// Caustic-channel reservoir (32 bytes). The random-replay seed fully determines the path.
struct CausticReservoir {
  uint  seed;   // replay seed: direction, wavelength and Fresnel choices are functions of it
  float W;      // unbiased contribution weight
  float M;      // confidence (number of candidates this reservoir represents)
  float pY;     // target function p_hat (luminance of f) at this pixel, cached
  vec4  f;      // XYZ contribution of the stored sample at this pixel, cached (w unused)
};
layout(set = 0, binding = 5, std430) buffer Res { CausticReservoir caustic[]; };
layout(set = 0, binding = 6, std430) buffer GBuf { vec4 gpos[]; };   // xyz = primary hit, w = 1 if diffuse floor
layout(push_constant) uniform PC {
  uint width; uint height; uint frame; uint mode;
  uint passId;   // 0 = candidate pass (mode 3 only), 1 = shading
  uint cands;    // candidates per pixel per frame
  uint pad0; uint pad1;
} pc;

const uint  MAT_DIFFUSE = 0u, MAT_EMISSIVE = 1u, MAT_GLASS = 2u;
const int   MAX_DEPTH = 32;
const float EPS = 1e-3;
const float DIFFUSE_ALBEDO = 0.6;   // spectrally flat for now
const float EMISSION = 12.0;        // luminance of the light (Y)
const float PI = 3.14159265358979;

// Area light: must match buildScene() in src/render.cpp. Faces down (-y).
const vec3  LIGHT_MIN  = vec3(-1.5, 4.0, -1.5);
const vec3  LIGHT_SIZE = vec3(3.0, 0.0, 3.0);
const float LIGHT_AREA = 9.0;
const int   CAUSTIC_MAX_GLASS = 8;   // glass interactions handled by the caustic channel

vec4 lightRadiance(vec4 lambda) {
  return EMISSION * vec4(whiteLightSpectrum(lambda.x), whiteLightSpectrum(lambda.y),
                         whiteLightSpectrum(lambda.z), whiteLightSpectrum(lambda.w));
}

// ---- RNG (PCG) --------------------------------------------------------------
uint pcg(inout uint s) {
  s = s * 747796405u + 2891336037u;
  uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
  return (w >> 22u) ^ w;
}
float rnd(inout uint s) { return float(pcg(s) >> 8) * (1.0 / 16777216.0); }
uint pcgHash(uint v) {
  uint s = v * 747796405u + 2891336037u;
  uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
  return (w >> 22u) ^ w;
}

// ---- Geometry ---------------------------------------------------------------
struct Hit { bool hit; float t; vec3 n; uint prim; };

Hit traceRay(vec3 o, vec3 d, float tmax) {
  rayQueryEXT rq;
  rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, 0xFF, o, 0.0, d, tmax);
  while (rayQueryProceedEXT(rq)) {}
  Hit h;
  h.hit = rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT;
  h.t = 0.0; h.n = vec3(0.0); h.prim = 0u;
  if (h.hit) {
    h.t = rayQueryGetIntersectionTEXT(rq, true);
    h.prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
    vec3 a = verts[indices[3u * h.prim + 0u]].xyz;
    vec3 b = verts[indices[3u * h.prim + 1u]].xyz;
    vec3 c = verts[indices[3u * h.prim + 2u]].xyz;
    h.n = normalize(cross(b - a, c - a));   // host guarantees outward winding
  }
  return h;
}

// Any hit before tmax blocks the shadow ray (glass counts as blocking).
bool occluded(vec3 o, vec3 d, float tmax) {
  rayQueryEXT rq;
  rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
                        0xFF, o, 0.0, d, tmax);
  while (rayQueryProceedEXT(rq)) {}
  return rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

vec3 cosineSample(vec3 n, float u1, float u2) {
  float r = sqrt(u1), phi = 2.0 * PI * u2;
  vec3 t = normalize(abs(n.x) > 0.9 ? cross(n, vec3(0, 1, 0)) : cross(n, vec3(1, 0, 0)));
  vec3 b = cross(n, t);
  return normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(max(0.0, 1.0 - u1)));
}

// eta = n_t / n_i, cosI >= 0
float fresnelDielectric(float cosI, float eta) {
  float sin2T = max(0.0, 1.0 - cosI * cosI) / (eta * eta);
  if (sin2T >= 1.0) return 1.0;
  float cosT = sqrt(1.0 - sin2T);
  float rpar  = (eta * cosI - cosT) / (eta * cosI + cosT);
  float rperp = (cosI - eta * cosT) / (cosI + eta * cosT);
  return 0.5 * (rpar * rpar + rperp * rperp);
}

vec3 eyePos() { return (pc.mode == 0u) ? vec3(0.0, 1.0, 6.0) : vec3(0.0, 2.2, 7.5); }

// Pinhole camera ray direction for pixel px with sub-pixel jitter (jx, jy).
vec3 cameraDir(uvec2 px, float jx, float jy) {
  vec3 target = vec3(0.0, 0.9, 0.0);
  vec3 fwd = normalize(target - eyePos());
  vec3 right = normalize(cross(fwd, vec3(0, 1, 0)));
  vec3 up = cross(right, fwd);
  vec2 uv = ((vec2(px) + vec2(jx, jy)) / vec2(pc.width, pc.height)) * 2.0 - 1.0;
  float tanHalfFov = tan(radians(40.0) * 0.5);
  float aspect = float(pc.width) / float(pc.height);
  return normalize(fwd + right * (uv.x * tanHalfFov * aspect) - up * (uv.y * tanHalfFov));
}

// Caustic-channel contribution (unnormalised XYZ) of replay seed `seed` at floor point x, normal n.
// Mirrors evalPath() in tests/restir_toy_test.cpp: cosine bounce -> glass chain (hero wavelength only,
// Fresnel-sampled) -> light. Counts only paths with 1..CAUSTIC_MAX_GLASS glass interactions that end on
// the light; every other outcome returns 0 and is left to the base estimator.
vec3 evalCaustic(vec3 x, vec3 n, uint seed) {
  uint st = pcgHash(seed ^ 0xA511E9B3u);
  float u0 = rnd(st), u1 = rnd(st), u2 = rnd(st);
  float lam = sampleVisible(u2);
  float pdf = visiblePdf(lam);
  if (pdf <= 0.0) return vec3(0.0);
  vec3 d = cosineSample(n, u0, u1);
  vec3 o = x + n * EPS;
  float thr = DIFFUSE_ALBEDO;
  int glass = 0;
  for (int i = 0; i <= CAUSTIC_MAX_GLASS + 1; ++i) {
    Hit h = traceRay(o, d, 1e30);
    if (!h.hit) return vec3(0.0);
    uint m = primMat[h.prim];
    bool front = dot(d, h.n) < 0.0;
    if (m == MAT_EMISSIVE) {
      if (!front || glass == 0) return vec3(0.0);        // direct light hits belong to NEE+MIS
      return xyzBar(lam) * (thr * EMISSION * whiteLightSpectrum(lam) / pdf);
    }
    if (m != MAT_GLASS) return vec3(0.0);                // left the glass onto the floor: base estimator
    if (glass >= CAUSTIC_MAX_GLASS) return vec3(0.0);
    ++glass;
    vec3 nf = front ? h.n : -h.n;
    vec3 p = o + d * h.t;
    float nG = sellmeierIor(GLASS_BK7, lam);
    float eta = front ? nG : 1.0 / nG;
    float F = fresnelDielectric(dot(-d, nf), eta);
    float uf = rnd(st);
    if (uf < F) {
      d = reflect(d, nf);
      o = p + nf * EPS;
    } else {
      d = normalize(refract(d, nf, 1.0 / eta));
      thr /= (eta * eta);
      o = p - nf * EPS;
    }
  }
  return vec3(0.0);
}

// Pass 0: find the primary hit; if it is the diffuse floor, draw pc.cands candidate seeds and RIS-select one.
void candidatePass(uvec2 px) {
  uint idx = px.y * pc.width + px.x;
  uint seed = pcgHash(px.x + pcgHash(px.y + pcgHash(pc.frame)));
  rnd(seed);                                   // same draw order as pass 1: wavelength, then jitter
  float jx = rnd(seed), jy = rnd(seed);
  vec3 d = cameraDir(px, jx, jy);
  vec3 eye = eyePos();
  Hit h = traceRay(eye, d, 1e30);

  CausticReservoir r;
  r.seed = 0u; r.W = 0.0; r.M = 0.0; r.pY = 0.0; r.f = vec4(0.0);
  vec4 gp = vec4(0.0);
  if (h.hit && primMat[h.prim] == MAT_DIFFUSE) {
    vec3 n = (dot(d, h.n) < 0.0) ? h.n : -h.n;
    vec3 x = eye + d * h.t;
    gp = vec4(x, 1.0);
    uint cs = pcgHash(seed ^ 0x68E31DA4u);      // candidate stream, independent of pass 1's stream
    float wsum = 0.0, pick = 0.0;
    for (uint c = 0u; c < pc.cands; ++c) {
      uint cseed = pcg(cs);
      vec3 f = evalCaustic(x, n, cseed);
      float w = f.y;                            // target p_hat = luminance; source pdf is uniform
      wsum += w;
      if (w > 0.0 && rnd(cs) * wsum < w) { r.seed = cseed; r.f = vec4(f, 0.0); pick = w; }
    }
    r.M = float(pc.cands);
    r.pY = pick;
    r.W = (pick > 0.0) ? wsum / (float(pc.cands) * pick) : 0.0;
  }
  caustic[idx] = r;
  gpos[idx] = gp;
}

void main() {
  uvec2 px = gl_GlobalInvocationID.xy;
  if (px.x >= pc.width || px.y >= pc.height) return;
  if (pc.passId == 0u) { if (pc.mode == 3u) candidatePass(px); return; }
  uint idx = px.y * pc.width + px.x;

  uint seed = pcgHash(px.x + pcgHash(px.y + pcgHash(pc.frame)));   // independent stream per (pixel, frame)

  // Wavelengths: one random number -> 4 stratified wavelengths.
  vec4 lambdaPdf;
  vec4 lambda = sampleHeroWavelengths(rnd(seed), lambdaPdf);

  // Pinhole camera.
  float jx = rnd(seed), jy = rnd(seed);
  vec3 d = cameraDir(px, jx, jy);
  vec3 o = eyePos();

  vec4 thr = vec4(1.0);   // per-wavelength path throughput
  vec4 L = vec4(0.0);     // per-wavelength radiance
  bool heroOnly = false;  // set once a dispersive surface is hit

  bool  useNEE = (pc.mode == 1u || pc.mode == 3u);
  // Caustic channel bookkeeping (mode 3): only pixels whose primary hit is the diffuse floor.
  bool  excludeCaustic = (pc.mode == 3u) && (gpos[idx].w > 0.5);
  bool  chainFromPrimary = false;   // path since the primary diffuse vertex has only glass vertices
  int   glassCount = 0;             // glass interactions in that chain
  bool  prevSpecular = true;   // camera ray / glass: no MIS (NEE cannot generate these paths)
  float prevBsdfPdf = 0.0;     // solid-angle pdf of the last diffuse bounce

  for (int depth = 0; depth < MAX_DEPTH; ++depth) {
    Hit h = traceRay(o, d, 1e30);
    if (!h.hit) {
      if (pc.mode == 0u) L += thr;   // furnace: environment radiance = 1 (flat spectrum)
      break;
    }
    uint m = primMat[h.prim];
    bool front = dot(d, h.n) < 0.0;
    vec3 nf = front ? h.n : -h.n;
    vec3 p = o + d * h.t;

    if (m == MAT_EMISSIVE) {
      // Skip exactly the events evalCaustic() counts; the caustic channel adds them back.
      bool inCausticChannel = excludeCaustic && chainFromPrimary && prevSpecular && glassCount >= 1 && glassCount <= CAUSTIC_MAX_GLASS;
      if (front && !inCausticChannel) {
        float w = 1.0;
        if (useNEE && !prevSpecular) {   // BSDF strategy of the diffuse-vertex MIS pair
          float cosL = max(-dot(d, h.n), 1e-6);
          float pl = (h.t * h.t) / (cosL * LIGHT_AREA);   // light-sampling pdf, solid angle
          w = (prevBsdfPdf * prevBsdfPdf) / (prevBsdfPdf * prevBsdfPdf + pl * pl);
        }
        L += thr * lightRadiance(lambda) * w;
      }
      break;
    } else if (m == MAT_DIFFUSE) {
      vec3 p0 = p + nf * EPS;
      if (useNEE) {              // NEE: uniformly sample the area light
        float u1 = rnd(seed), u2 = rnd(seed);
        vec3 lp = LIGHT_MIN + vec3(u1 * LIGHT_SIZE.x, 0.0, u2 * LIGHT_SIZE.z);
        vec3 wi = lp - p0;
        float dist2 = dot(wi, wi);
        float dist = sqrt(dist2);
        wi /= dist;
        float cosS = dot(nf, wi);
        float cosL = wi.y;       // light normal is (0,-1,0)
        if (cosS > 0.0 && cosL > 0.0 && !occluded(p0, wi, dist - 0.01)) {
          float pl = dist2 / (cosL * LIGHT_AREA);   // solid-angle pdf
          float pb = cosS / PI;                     // BSDF pdf for the same direction
          float w = (pl * pl) / (pl * pl + pb * pb);
          L += thr * lightRadiance(lambda) * ((DIFFUSE_ALBEDO / PI) * cosS / pl * w);
        }
      }
      thr *= DIFFUSE_ALBEDO;
      float v1 = rnd(seed), v2 = rnd(seed);
      d = cosineSample(nf, v1, v2);
      prevBsdfPdf = max(dot(d, nf), 1e-6) / PI;
      prevSpecular = false;
      chainFromPrimary = (depth == 0) && excludeCaustic;   // a later diffuse vertex starts a new, unhandled chain
      glassCount = 0;
      o = p0;
    } else {
      // Dispersive dielectric: companions would diverge, so continue with hero only.
      heroOnly = true;
      prevSpecular = true;
      ++glassCount;
      float nG  = sellmeierIor(GLASS_BK7, lambda.x);
      float eta = front ? nG : 1.0 / nG;
      float cosI = dot(-d, nf);
      float F = fresnelDielectric(cosI, eta);
      if (rnd(seed) < F) {
        d = reflect(d, nf);
        o = p + nf * EPS;
      } else {
        d = normalize(refract(d, nf, 1.0 / eta));
        thr /= (eta * eta);          // radiance scaling (camera-side transport)
        o = p - nf * EPS;
      }
    }

    if (depth >= 3) {                // Russian roulette
      float tmax = heroOnly ? thr.x : max(max(thr.x, thr.y), max(thr.z, thr.w));
      float q = clamp(tmax, 0.05, 0.95);
      if (rnd(seed) >= q) break;
      thr /= q;
    }
  }

  vec3 xyz = vec3(0.0);
  if (heroOnly) {
    xyz = L.x * heroOnlyWeight(lambdaPdf) * xyzBar(lambda.x);
  } else {
    vec4 w = stratifiedWeights(lambdaPdf);
    for (int i = 0; i < NUM_LAMBDA; ++i) xyz += w[i] * L[i] * xyzBar(lambda[i]);
  }
  if (excludeCaustic) {                // add the caustic channel: f(y) * W from this pixel's reservoir
    CausticReservoir r = caustic[idx];
    if (r.W > 0.0) xyz += r.f.xyz * r.W;
  }
  if (any(isnan(xyz)) || any(isinf(xyz))) return;

  accum[idx] += vec4(xyz, 1.0);
}
